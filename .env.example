# Шаблон переменных окружения.
# Скопируй этот файл в .env и заполни своими значениями.
# .env в git НЕ коммитится (репозиторий публичный)!

# PostgreSQL. Формат: postgresql+psycopg://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql+psycopg://postgres:ВАШ_ПАРОЛЬ@localhost:5432/career_db

# Секрет для подписи JWT-токенов. Поставь длинную случайную строку.
SECRET_KEY=замени-на-длинную-случайную-строку

# OAuth-токен приложения hh.ru (для парсера вакансий). Можно оставить пустым для запуска.
HH_ACCESS_TOKEN=

# Как часто (в часах) планировщик обновляет вакансии.
SCHEDULER_INTERVAL_HOURS=24

# Включать ли фоновый импорт вакансий с hh. На первый деплой — false.
SCHEDULER_ENABLED=false

# Ключ OpenAI для анализа навыков и чата. Без него эти функции недоступны.
OPENAI_API_KEY=

# Разрешённые origin фронтенда, через запятую. Точно scheme+host+port, без слэша в конце.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
